    {
      "name": "PubMed 科研主题搜索",
      "kind": "pubmed_search",
      "url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
      "category": "research",
      "query": "(microbiome[Title] OR \"human learning\"[Title] OR \"sleep and memory\"[Title] OR \"decision making\"[Title]) AND hasabstract[text] NOT (review[pt] OR editorial[pt] OR case reports[pt])",
      "scan_limit": 20,
      "limit": 5,
      "window_hours": 720
    },
    {
      "name": "Nature 科研",
      "kind": "rss",
      "url": "https://www.nature.com/nature.rss",
      "category": "research",
      "limit": 8,
      "window_hours": 168,
      "exclude_pattern": "^(Retraction|Correction|Editorial|Obituary|Author Correction|Publisher Correction)",
      "url_pattern": "/articles/s41586-"
    },
    {
      "name": "PubMed 心理学主题搜索",
      "kind": "pubmed_search",
      "url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
      "category": "psychology",
      "query": "(\"emotion regulation\"[Title] OR \"social connection\"[Title] OR \"cognitive bias\"[Title] OR \"attention control\"[Title] OR mindfulness[Title]) AND humans[mh] AND hasabstract[text] NOT (drug[Title] OR cancer[Title] OR case reports[pt])",
      "scan_limit": 20,
      "limit": 5,
      "window_hours": 1440,
      "exclude_pattern": "(neural network|generative|deep learning|machine learning|spectral|GAN|contrastive)"
    },
    {
      "name": "APS 心理研究",
      "kind": "rss",
      "url": "https://www.psychologicalscience.org/feed",
      "category": "psychology",
      "limit": 6,
      "window_hours": 720,
      "exclude_pattern": "(APS Submits|Annual Convention|Award|Call for|Membership)"
    },
    {
      "name": "PubMed 日常健康主题搜索",
      "kind": "pubmed_search",
      "url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/",
      "category": "health",
      "query": "(\"sleep quality\"[Title] OR \"sleep duration\"[Title] OR \"physical activity\"[Title] OR sedentary[Title] OR \"dietary pattern\"[Title]) AND (systematic review[pt] OR meta-analysis[pt]) AND humans[mh] NOT (drug[Title] OR supplement[Title] OR cancer[Title] OR surgery[Title] OR surgical[Title] OR patients[Title] OR disease[Title])",
      "scan_limit": 20,
      "limit": 5,
      "window_hours": 1440,
      "exclude_pattern": "(tonsil|pharyng|surgery|surgical|ketogenic|capsaicin|creatine|cancer)|preterm|infant|therapeutic|stimulation|pain|sleep apnea"
    },
    {
      "name": "Cleveland Clinic 日常健康",
      "kind": "articles",
      "url": "https://health.clevelandclinic.org/",
      "article_pattern": "/[a-z0-9]+(?:-[a-z0-9]+){2,}",
      "category": "health",
      "limit": 5,
      "window_hours": 2160,
      "scan_limit": 6
    }
  ],
  "dedup_days": 90,
  "section_limits": {
    "github": 3,
    "ai_tips": 2,
    "growth": 2,
    "health": 1,
    "research": 1,
    "psychology": 1,
    "major_ai": 3
  }
