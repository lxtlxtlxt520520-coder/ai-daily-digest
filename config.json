    {
      "name": "GitHub 实用工具主题搜索",
      "kind": "github_search",
      "url": "https://api.github.com/search/repositories",
      "category": "github",
      "limit": 8,
      "scan_limit": 20,
      "window_hours": 24,
      "queries": [
        "stars:>=1000 archived:false fork:false automation in:name,description,topics",
        "stars:>=1000 archived:false fork:false workflow in:name,description,topics",
        "stars:>=1000 archived:false fork:false research in:name,description,topics",
        "stars:>=1000 archived:false fork:false productivity in:name,description,topics"
      ],
      "queries_per_run": 2
    },
    {
      "name": "社区主题检索（AI技巧）",
      "kind": "hn_search",
      "url": "https://hn.algolia.com/api/v1/search",
      "category": "ai_tips",
      "queries": [
        "Claude Code",
        "Codex",
        "LLM workflow",
        "prompt",
        "AI automation",
        "MCP"
      ],
      "queries_per_run": 2,
      "min_points": 15,
      "scan_limit": 6,
      "limit": 5,
      "window_hours": 720,
      "ai_filter": true,
      "include_pattern": "(workflow|tutorial|guide|prompt|how to|tools|coding agents|agent|automation|tips|skills)",
      "exclude_pattern": "(missile|Houthis|funding|valuation|lawsuit|changelog| AGENTS.md|telemetry|Siri|benchmark)"
    },
    {
      "name": "Ethan Mollick 原创应用文章",
      "kind": "rss",
      "url": "https://www.oneusefulthing.org/feed",
      "category": "ai_tips",
      "limit": 5,
      "window_hours": 720,
      "practical_excerpt": true
    },
    {
      "name": "Simon Willison 原创实践",
      "kind": "rss",
      "url": "https://simonwillison.net/atom/everything/",
      "category": "ai_tips",
      "limit": 10,
      "window_hours": 720,
      "ai_filter": true,
      "practical_excerpt": true,
      "exclude_pattern": "^(Quoting |GPT |Claude |OpenAI DevDay |2026 in LLMs|SF October|Jev introduces)"
