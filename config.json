      "limit": 8,
      "scan_limit": 8,
      "min_stars": 1000,
      "window_hours": 24
    },
    {
      "name": "GitHub Skills与Agent主题搜索",
      "kind": "github_search",
      "url": "https://api.github.com/search/repositories",
      "category": "github",
      "limit": 8,
      "scan_limit": 20,
      "window_hours": 24,
      "queries": [
        "stars:>=1000 archived:false fork:false skill in:name,description,topics",
        "stars:>=1000 archived:false fork:false mcp in:name,description,topics",
