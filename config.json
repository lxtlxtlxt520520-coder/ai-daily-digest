      "category": "major_ai",
      "limit": 6,
      "window_hours": 72
    },
    {
      "name": "Google AI 官方资讯",
      "kind": "rss",
      "url": "https://blog.google/technology/ai/rss/",
      "category": "major_ai",
      "limit": 6,
      "window_hours": 72
    },
    {
      "name": "Anthropic 官方公告",
      "kind": "articles",
