      "kind": "github_search",
      "url": "https://api.github.com/search/repositories",
      "category": "github",
      "query": "stars:>=300 archived:false fork:false (agent OR automation OR mcp OR skill) in:name,description,topics",
      "created_days": 90,
      "min_stars": 300,
      "scan_limit": 20,
      "limit": 6,
      "window_hours": 24
    },
    {
      "name": "GitHub 今日趋势",
      "kind": "github_trending",
