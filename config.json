      "include_pattern": "(learn|habit|decision|communicat|focus|productiv|memory|attention|procrastinat)",
      "exclude_pattern": "(machine learning|reinforcement|SQLite|OpenGL|antidepressant|solar panels|continual learning|model|GPU|VRAM|embedding|AI company)"
    },
    {
      "name": "James Clear 成长通讯",
